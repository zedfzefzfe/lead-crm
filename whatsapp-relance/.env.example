# Copie ce fichier en .env et remplis-le.
# Clé du programme d'envoi : CRM > Relance WhatsApp (visible par un admin) > "Clé du programme".
RELANCE_TOKEN=COLLE_LA_CLE_ICI
# Optionnel mais conseillé : le numéro SECONDAIRE (ex. 2126XXXXXXXX). Tout autre numéro scanné est déconnecté aussitôt.
WA_ALLOWED_NUMBER=
