+// CRM: save the booking in Supabase. Fire-and-forget: any error is only logged,
+// so it never blocks EmailJS, the Pixel or the thank-you screen.
+function saveLeadToCRM(nom, telephone, ville){
+  try {
+    const sb = CONFIG.supabase;
+    if (!window.supabase || !sb.url || !sb.anonKey || sb.url.indexOf('PASTE_') === 0) return;
+    if (!window._crm) window._crm = window.supabase.createClient(sb.url, sb.anonKey, { auth: { persistSession: false } });
+    window._crm.from('leads')
+      .insert({ nom: nom, telephone: telephone, ville: ville, source: 'landing', atelier: sb.atelier })
+      .then(function (res) { if (res.error) console.warn('CRM', res.error); }, function (err) { console.warn('CRM', err); });
+  } catch (err) { console.warn('CRM', err); }
+}
